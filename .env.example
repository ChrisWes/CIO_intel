# Anthropic API — used to classify articles and extract appointment details
# Obtain from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# NewsAPI.org — optional broad sweep across senior tech leadership titles
# Obtain from: https://newsapi.org/
# Leave blank to run RSS-only (the named trade press sources still work without this).
# NOTE: newsapi.org's free "Developer" plan is licensed for dev/testing only, not
# production use — see README "Open decisions" before relying on it for real digests.
NEWS_API_KEY=
